# Application
APP_NAME=BusinessChat
APP_ENV=development
LOG_LEVEL=info

# API server (used when running locally outside Docker)
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=businesschat
POSTGRES_PASSWORD=businesschat
POSTGRES_DB=businesschat

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# OpenAI — required for Phase 4+ (embeddings and Q&A)
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Application
APP_NAME=BusinessChat
APP_ENV=development
LOG_LEVEL=info

# API server (used when running locally outside Docker)
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=businesschat
POSTGRES_PASSWORD=businesschat
POSTGRES_DB=businesschat

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# LLM (used in later phases)
OPENAI_API_KEY=
